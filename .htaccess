DirectoryIndex index.html index.php
Options -Indexes
AddDefaultCharset UTF-8

RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+portfolio\.html(?:[?\s]) [NC]
RewriteRule ^portfolio\.html$ /proekty/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+privacy\.html(?:[?\s]) [NC]
RewriteRule ^privacy\.html$ /politika-konfidencialnosti/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+project\.html\?id=([^&\s]+) [NC]
RewriteRule ^project\.html$ /proekty/%1/ [R=301,L,NE]
RewriteRule ^proekty/?$ portfolio.html [L]
RewriteRule ^proekty/([a-z0-9-]+)/?$ project.html?id=$1 [L,QSA]
RewriteRule ^politika-konfidencialnosti/?$ privacy.html [L]

<FilesMatch "\.(md|log|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
